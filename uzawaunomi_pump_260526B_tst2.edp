// uzawaunomi_region_check.edp
// border内のregion指定が正しく拾えているかをP0関数のplotで確認するコード

real w = 0.25;      // 原子炉容器半径
real H = 0.8;       // 原子炉容器高さ
real S = 0.1;       // シュラウド下端
real H1 = 0.6;      // シュラウド高さ
real d = 0.15;      // シュラウド内径
real w1 = 0.03;     // シュラウド厚み
real rpipe = 0.02;  // 中心軸回避用パイプ半径
real d2 = 0.025;    // frozen wall

int regFluid = 10;
int regSolid = 20;

// --- 1. 境界の定義と領域番号（region）の焼き付け ---
border C1(t=rpipe, w-d2) {x=t; y=d2; label=1; region=regFluid;}
border C2(t=d2, H){x=w-d2; y=t; label=2; region=regFluid;}
border C3(t=w-d2,rpipe){x=t; y=H; label=3; region=regFluid;}
border Cpipe(t=H,d2){x=rpipe; y=t; label=12; region=regFluid;}

border D1(t=-pi,0){x=d+w1/2.0 + (w1/2.0)*cos(t); y=S + (w1/2.0)*sin(t); label=21; region=regSolid;}
border D2(t=S, S+H1) {x=d+w1; y=t; label=22; region=regSolid;}
border D3(t=0, pi) {x=d+w1/2.0 + (w1/2.0)*cos(t); y=S+H1 + (w1/2.0)*sin(t); label=23; region=regSolid;}
border D4(t=S+H1, S) {x=d; y=t; label=24; region=regSolid;}

// --- 2. メッシュ生成 ---
mesh Th = buildmesh(C1(20) + C2(80) + C3(20) + Cpipe(80) + D1(10) + D2(40) + D3(10) + D4(40));

// --- 3. 標準的な方法による領域番号の回収と可視化 ---
fespace RegH(Th, P0);    // 要素ごとに領域番号を保持するための不連続空間
RegH ThRegion = region;  // FreeFEMの組み込み変数region（要素のID）を代入

// --- 4. 画面表示 ---
// 1枚目：通常のメッシュ形状を表示
plot(Th, wait=1, cmm="1. Mesh Geometry");

// 2枚目：領域番号（10と20）で色分けして表示
// 正常に拾えていれば、シュラウドの肉厚部（20）とそれ以外（10）でパキッと色が分かれます
plot(ThRegion, fill=true, value=true, wait=1, cmm="2. Region Color Map (Fluid=10, Solid=20)");